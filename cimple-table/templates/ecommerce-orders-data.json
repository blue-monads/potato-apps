    {
      "id": "orders",
      "name": "Orders",
      "description": "Customer purchase orders, payment, and shipping status",
      "icon": "receipt",
      "color": "amber",
      "columns": [
        {
          "name": "Order Number",
          "column_type": "text",
          "info": "Order ID #",
          "required": true
        },
        {
          "name": "Customer",
          "column_type": "ref",
          "info": "Placing customer",
          "target_group_table": "customers",
          "target_column": "name",
          "required": true
        },
        {
          "name": "Order Date",
          "column_type": "date",
          "info": "Date placed"
        },
        {
          "name": "Total Amount",
          "column_type": "number",
          "info": "Total order sum"
        },
        {
          "name": "Payment Status",
          "column_type": "dropdown",
          "info": "Payment status",
          "options": "Pending, Paid, Refunded, Failed"
        },
        {
          "name": "Fulfillment",
          "column_type": "dropdown",
          "info": "Shipping status",
          "options": "Unfulfilled, Processing, Shipped, Delivered, Returned"
        }
