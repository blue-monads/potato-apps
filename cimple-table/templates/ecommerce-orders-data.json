{
  "id": "ecommerce-orders",
  "name": "E-Commerce & Orders",
  "description": "Manage product catalogs, customer accounts, orders, and line items",
  "category": "Commerce",
  "icon": "cart-shopping",
  "color": "emerald",
  "tables": [
    {
      "id": "products",
      "name": "Products",
      "description": "Product inventory, pricing, and stock status",
      "icon": "box",
      "color": "emerald",
      "columns": [
        {
          "name": "Product Name",
          "column_type": "text",
          "info": "Name of item",
          "required": true
        },
        {
          "name": "SKU",
          "column_type": "text",
          "info": "Stock keeping unit"
        },
        {
          "name": "Category",
          "column_type": "dropdown",
          "info": "Product category",
          "options": "Electronics, Apparel, Home & Kitchen, Health, Books"
        },
        {
          "name": "Unit Price",
          "column_type": "number",
          "info": "Price in USD"
        },
        {
          "name": "Stock Quantity",
          "column_type": "number",
          "info": "Current inventory count"
        },
        {
          "name": "Status",
          "column_type": "dropdown",
          "info": "Availability",
          "options": "In Stock, Low Stock, Backordered, Discontinued"
        }
      ],
