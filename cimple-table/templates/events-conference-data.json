        {
          "name": "Start Date",
          "column_type": "date",
          "info": "Opening date"
        },
        {
          "name": "End Date",
          "column_type": "date",
          "info": "Closing date"
        },
        {
          "name": "Venue",
          "column_type": "text",
          "info": "Location or platform"
        },
        {
          "name": "Capacity",
