    {
      "id": "software",
      "name": "Software Licenses",
      "description": "SaaS subscriptions, seat counts, and annual renewals",
      "icon": "certificate",
      "color": "indigo",
      "columns": [
        {
          "name": "Software Name",
          "column_type": "text",
          "info": "Tool name",
          "required": true
        },
        {
          "name": "Vendor",
          "column_type": "text",
          "info": "Publisher"
        },
        {
          "name": "Seats Purchased",
          "column_type": "number",
          "info": "Total seats"
        },
        {
          "name": "Renewal Date",
          "column_type": "date",
          "info": "Renewal deadline"
        },
        {
          "name": "Annual Cost",
          "column_type": "number",
          "info": "Cost in USD"
        }
      ],
